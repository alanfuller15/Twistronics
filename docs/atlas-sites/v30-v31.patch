diff --git a/dist/bands3d.css b/dist/bands3d.css
index 8024268..c93b661 100644
--- a/dist/bands3d.css
+++ b/dist/bands3d.css
@@ -10,3 +10,9 @@
 .band-readout{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:28px 0}.band-readout>div{border-top:1px solid var(--line);padding-top:17px}.band-readout span{font-size:.875rem;color:var(--cyan);letter-spacing:.06em}.band-readout p{margin:10px 0;color:var(--muted);font-size:1rem}
 @media(max-width:1100px){.lessons button{font-size:.85rem}.band-workbench{grid-template-columns:280px minmax(0,1fr)}.band-stage{height:490px}}
 @media(max-width:720px){.lessons{display:flex}.lessons button{font-size:.9rem}.band-toolbar{grid-template-columns:1fr;gap:14px}.band-toolbar select{font-size:.95rem}.band-workbench{grid-template-columns:1fr}.band-stage{height:405px}.band-workbench>.visual-panel{grid-row:1}.band-camera-controls{gap:6px;padding:12px}.band-camera-controls button{flex:1;font-size:.875rem;white-space:nowrap}.band-readout{grid-template-columns:1fr;gap:10px}.band-workbench .plot-header{padding:16px}.band-legend{padding:8px 16px}.band-help{padding:10px 16px}.band-workbench .controls{padding:20px}.band-workbench .plot-footer{padding:14px 16px}}
+
+/* v31: a quieter stage and deliberate shape lighting, with unchanged rulers. */
+.band-stage,.wave-stage,.graphene-stage{background:radial-gradient(ellipse at 48% 32%,#1d354a 0%,#0c1b2b 48%,#060e19 100%);box-shadow:inset 0 1px 0 #c9e9ff12,inset 0 -28px 56px #02071045}
+.band-camera-controls button,.wave-camera button{border-color:#476276;background:#14283b;border-radius:8px;min-height:44px}
+.band-camera-controls button:hover,.wave-camera button:hover{background:#203e55;border-color:#7bcadf}
+.band-legend{gap:12px 22px}.band-legend i{box-shadow:0 0 0 3px #ffffff08}
