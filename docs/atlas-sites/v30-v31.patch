new file mode 100644
index 0000000..53f40f7
--- /dev/null
+++ b/src/scene-style.js
@@ -0,0 +1,25 @@
+import * as THREE from 'three';
+
+// Neutral illumination for shape cues only. No displacement, interpolation,
+// shadows, bloom or depth-of-field: sample positions and quantitative rulers
+// remain the data encoding. Basic materials (including phase colors) stay unlit.
+export function lightScene(scene, renderer) {
+  if (renderer.isWebGLRenderer) {
+    renderer.outputColorSpace = THREE.SRGBColorSpace;
+    renderer.toneMapping = THREE.NoToneMapping;
+  }
+  scene.add(new THREE.HemisphereLight(0xffffff, 0xb3c4d2, 1.25));
+  const key = new THREE.DirectionalLight(0xffffff, 2.1);
+  key.position.set(-5, 10, 7); scene.add(key);
+  const fill = new THREE.DirectionalLight(0xffffff, .65);
+  fill.position.set(7, 4, -5); scene.add(fill);
+}
+
+export function surfaceMaterial() {
+  return new THREE.MeshStandardMaterial({vertexColors:true, side:THREE.DoubleSide,
+    roughness:.52, metalness:0});
+}
+
+export function markerMaterial(color) {
+  return new THREE.MeshStandardMaterial({color, roughness:.36, metalness:0});
+}
