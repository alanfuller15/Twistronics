+'use strict';
+(() => {
+const $=id=>document.getElementById(id);
+document.querySelectorAll('[data-story-next]').forEach(button=>button.addEventListener('click',()=>{
+ const target=$(button.dataset.storyNext),title=target.querySelector('h2');
+ target.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});
+ title.setAttribute('tabindex','-1');title.focus({preventScroll:true});
+}));
+const initial=Number($('angle').value),length=theta=>.246/(2*Math.sin(theta*Math.PI/360));
+function discovery(){const theta=Number($('angle').value),factor=length(theta)/length(initial);
+ $('twist-discovery').textContent=Math.abs(theta-initial)<.001?'At this starting angle, two fine lattices make a much larger repeat. Try a smaller angle.':factor>1?`You made the repeating pattern ${factor.toFixed(1)}× as wide as at the starting angle. This larger pattern is called moiré.`:`You made the repeating pattern smaller—${Math.round(factor*100)}% of its starting width. This larger-scale pattern is called moiré.`;
+}
+$('angle').addEventListener('change',discovery);
+document.querySelectorAll('[data-angle]').forEach(b=>b.addEventListener('click',()=>queueMicrotask(discovery)));
+$('layer-reset').addEventListener('click',()=>queueMicrotask(discovery));
+// Keep the first action prominent; reveal secondary view controls on request.
+const options=document.createElement('details');options.className='story-view-options';
+const summary=document.createElement('summary');summary.textContent='View options · layers, zoom & fit';options.append(summary);
+const visual=$('moire-canvas').parentElement;
+visual.append(options);
+visual.querySelectorAll('.moire-toolbar').forEach(toolbar=>options.append(toolbar));
+})();
