+.coverage-detail-heading{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;max-width:480px;margin:0 auto 10px;font-size:.9375rem}.coverage-detail-heading span{color:#ffdb83}
+#coverage-closeup{display:block;width:100%;height:auto;max-width:480px;margin:auto;background:#214d63;border:1px solid #8aabbd}
+.coverage-detail-help{font-size:.9375rem;line-height:1.5;max-width:480px;margin:12px auto 0;color:#d0e2ec}
+@media(max-width:370px){.coverage-preview{padding:12px}.coverage-locator-row{grid-template-columns:96px minmax(0,1fr);gap:12px}#model-coverage #coverage-overview{width:96px;height:96px}}
