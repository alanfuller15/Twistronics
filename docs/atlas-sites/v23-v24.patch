@@ -0,0 +1,42 @@
+'use strict';
+(() => {
+const $=id=>document.getElementById(id), NS='http://www.w3.org/2000/svg';
+const latest=window.TWISTRONICS_COVERAGE.runs.at(-1);
+const cells=Object.entries(latest.quadrants).flatMap(([q,g])=>['accepted','frontier','unresolved'].flatMap(kind=>g[kind].map(([d,x,y])=>({d,x,y,q,kind}))));
+const unresolved=cells.filter(c=>c.kind==='unresolved');
+const depth=Math.max(...unresolved.map(c=>c.d)),side=2**depth,span=16;
+const colors={accepted:'#214d63',frontier:'#ad9ade',unresolved:'#ffca50'};
+function svg(parent,tag,attrs,text){const e=document.createElementNS(NS,tag);for(const [k,v] of Object.entries(attrs))e.setAttribute(k,v);if(text!==undefined)e.textContent=text;parent.append(e);return e;}
+function bounds(c){const scale=2**(depth-c.d);return {x:c.x*scale,y:c.y*scale,w:scale};}
+function inside(c,w){const b=bounds(c);return b.x>=w.x&&b.x+b.w<=w.x+span&&b.y>=w.y&&b.y+b.w<=w.y+span;}
+// Greedy, deterministic close-ups of the retained cells; no invented cells or area.
+let remaining=[...unresolved];const windows=[];
+while(remaining.length){
+ let best=null;
+ for(const c of remaining){const b=bounds(c),w={x:Math.max(0,Math.min(side-span,b.x-8)),y:Math.max(0,Math.min(side-span,b.y-8)),q:c.q};w.count=remaining.filter(c=>inside(c,w)).length;if(!best||w.count>best.count)best=w;}
+ if(!best.count)throw new Error('Unresolved cell is too large for this close-up');
+ windows.push(best);remaining=remaining.filter(c=>!inside(c,best));
+}
+const overview=$('coverage-overview');
+svg(overview,'title',{},`${latest.label}: whole square. Markers locate unresolved areas; their sizes do not represent area.`);
+for(const c of cells){const n=2**c.d;svg(overview,'rect',{x:320*c.x/n,y:320*(1-(c.y+1)/n),width:320/n,height:320/n,fill:colors[c.kind],stroke:'none'});}
+svg(overview,'path',{d:'M160 0V320M0 160H320',stroke:'#7192a4','stroke-width':1,fill:'none'});
+const locators=windows.map(w=>svg(overview,'circle',{cx:320*(w.x+span/2)/side,cy:320*(1-(w.y+span/2)/side),r:4,fill:'#ffca50',stroke:'#06121c','stroke-width':1.5}));
+const ring=svg(overview,'circle',{r:12,fill:'none',stroke:'#fff','stroke-width':3});
+$('coverage-magnification').textContent=`${side/span}× closer`;
+function draw(i){
+ const w=windows[i],plot=$('coverage-closeup');plot.replaceChildren();const count=unresolved.filter(c=>inside(c,w)).length;
+ $('coverage-detail-title').textContent=`Area ${i+1} of ${windows.length} · ${w.q.toUpperCase()}`;
+ $('coverage-detail-count').textContent=`${count} unresolved cells`;
+ svg(plot,'title',{},`Area ${i+1}, ${count} unresolved depth-${depth} cells. ${side/span} times enlargement in each direction.`);
+ for(const c of cells){const b=bounds(c),x0=Math.max(b.x,w.x),x1=Math.min(b.x+b.w,w.x+span),y0=Math.max(b.y,w.y),y1=Math.min(b.y+b.w,w.y+span);if(x1<=x0||y1<=y0)continue;
+  const x=(x0-w.x)*320/span,y=(w.y+span-y1)*320/span,width=(x1-x0)*320/span,height=(y1-y0)*320/span;
+  svg(plot,'rect',{x,y,width,height,fill:colors[c.kind],stroke:c.kind==='unresolved'?'#06121c':'#65889c','stroke-width':c.kind==='unresolved'?1.6:.7,'data-status':c.kind});
+  if(c.kind==='unresolved')svg(plot,'circle',{cx:x+width/2,cy:y+height/2,r:2.5,fill:'#06121c','aria-hidden':'true'});
+ }
+ ring.setAttribute('cx',locators[i].getAttribute('cx'));ring.setAttribute('cy',locators[i].getAttribute('cy'));
+ [...$('coverage-area-buttons').children].forEach((b,j)=>b.setAttribute('aria-pressed',String(i===j)));
+}
+windows.forEach((w,i)=>{const b=document.createElement('button');b.type='button';b.textContent=`Area ${i+1}`;b.addEventListener('click',()=>draw(i));$('coverage-area-buttons').append(b);});
+draw(0);
+})();
